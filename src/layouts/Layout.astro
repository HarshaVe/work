---
import '../styles/global.css';
import { contact } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** The "Let's talk" heading and buttons; off on the contact pages themselves. */
  showContactBand?: boolean;
  /** Wide image for link previews (e.g. a case study hero); defaults to the headshot. */
  image?: string;
  /** Keep direct-link-only pages (the /for pages) out of search results. */
  noindex?: boolean;
}

const {
  title,
  description = 'Global Director, Experience Design & Research at Siemens. Design and research leadership, from employee zero to 120-person practices.',
  showContactBand = true,
  image,
  noindex = false,
} = Astro.props;

// Link previews (Slack, email, LinkedIn): absolute URLs built from `site` in astro.config.mjs.
const pageTitle = title === 'Home' ? 'Harsha Vemulapalli — Design Leadership' : `${title} | Harsha Vemulapalli`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const previewImage = new URL(image ?? '/images/harsha-headshot-768.jpg', Astro.site);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { label: 'Work', href: '/portfolio' },
  { label: 'About', href: '/about' },
  { label: 'Resume', href: '/resume' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..800;1,400&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Harsha Vemulapalli" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={previewImage} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
  </head>
  <body>
    <slot name="banner" />

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class:list={['site-name', { 'is-home': currentPath === '/' }]} aria-label="Harsha Vemulapalli, home">
          <svg class="site-mark" viewBox="0 0 100 100" aria-hidden="true">
            <path class="site-mark-disc" d="M52 7 C77 8,93 27,92 51 C91 76,72 93,48 92 C24 91,7 73,8 49 C9 26,28 6,52 7 Z" />
            <path class="site-mark-stroke" pathLength="1" style="--w: 0.5s; --d: 0.22s" d="M29 34 C29.6 46,28.8 58,29.4 68" />
            <path class="site-mark-stroke" pathLength="1" style="--w: 0.68s; --d: 0.22s" d="M45 33 C45.4 45,44.8 58,45.3 69" />
            <path class="site-mark-stroke" pathLength="1" style="--w: 0.86s; --d: 0.18s" d="M28 51.5 C33 50.6,39 51.8,45.5 50.4" />
            <path class="site-mark-stroke" pathLength="1" style="--w: 1s; --d: 0.35s" d="M54 34 C57 46,60 57,63.5 68 C66.5 57,69.5 45,73 33" />
          </svg>
          <span class="site-name-text">
            <span class="site-name-default">Harsha Vemulapalli</span>
            <span class="site-name-hover" aria-hidden="true">Return to homepage</span>
          </span>
        </a>
        <script is:inline>
          // The HV mark lands and draws itself once per visit; on hover the letters rewrite
          // (the hint that it's the link home). Runs inline, before first paint, so it never flashes.
          (function () {
            var link = document.querySelector('.site-name');
            var mark = link && link.querySelector('.site-mark');
            if (!mark || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            // "draw" = circle lands, then letters; "rewrite" = letters only (on hover).
            function play(kind) {
              mark.classList.remove('draw', 'rewrite');
              void mark.getBoundingClientRect();
              mark.classList.add(kind);
            }
            var seen = false;
            try { seen = sessionStorage.getItem('hv-drawn') === '1'; sessionStorage.setItem('hv-drawn', '1'); } catch (e) {}
            if (!seen) play('draw');
            link.addEventListener('mouseenter', function () { play('rewrite'); });
          })();
        </script>
        <nav aria-label="Main">
          <button class="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
            <span class="hamburger"></span>
          </button>
          <div class="nav-links" id="nav-links">
            {navItems.map((item) => (
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
            ))}
            <a href="/contact" class="nav-cta" aria-current={currentPath === '/contact' ? 'page' : undefined}>Get in touch</a>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer" id="contact">
      <div class="container footer-inner">
        <div class="footer-pitch">
          {showContactBand && <p class="footer-title">Let's talk.</p>}
          <p class="footer-details">
            Made by <a href="/about/">me</a>, in Detroit, with some technical help from <a href="https://claude.ai" target="_blank" rel="noopener noreferrer">Claude</a>.
            Built on <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> and hosted on <a href="https://netlify.com" target="_blank" rel="noopener noreferrer">Netlify</a>.
          </p>
        </div>
        {showContactBand && (
          <div class="footer-actions">
            <a href={contact.linkedin} class="button button-secondary" target="_blank" rel="noopener noreferrer">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a>
            <a href={contact.resumePdf} class="button button-secondary" download>Download resume</a>
            <a href="/contact" class="button button-primary">Get in touch</a>
          </div>
        )}
      </div>
    </footer>

    <script>
      const menuToggle = document.querySelector('.menu-toggle');
      const navLinks = document.querySelector('.nav-links');

      function closeMenu() {
        if (!menuToggle || !navLinks) return;
        menuToggle.setAttribute('aria-expanded', 'false');
        navLinks.classList.remove('open');
      }

      if (menuToggle && navLinks) {
        menuToggle.addEventListener('click', () => {
          const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
          menuToggle.setAttribute('aria-expanded', String(!isExpanded));
          navLinks.classList.toggle('open', !isExpanded);
        });

        document.addEventListener('click', (event) => {
          if (!menuToggle.contains(event.target) && !navLinks.contains(event.target)) closeMenu();
        });

        navLinks.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 76px;
    position: relative;
  }

  /* Hand-drawn HV mark + name. It's the link home: on hover the mark redraws itself and
     the name changes to "Return to homepage". */
  .site-name {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
  }

  /* HV mark: a hand-drawn solid navy circle with white hand-drawn letters. On first
     load the circle drops in and lands with a small squash (a "thud"), then each letter
     stroke draws in; on hover only the letters redraw. Strokes animate
     stroke-dashoffset 1 → 0; --w is a stroke's delay, --d its duration. */
  .site-mark {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    overflow: visible;
  }

  .site-mark-disc {
    fill: var(--color-accent-strong);
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  .site-mark-stroke {
    fill: none;
    stroke: var(--color-surface);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .site-mark.draw .site-mark-disc {
    animation: land 0.5s cubic-bezier(0.5, 0, 0.3, 1) both;
  }

  .site-mark.draw .site-mark-stroke {
    animation: draw-stroke var(--d, 0.3s) cubic-bezier(0.6, 0.05, 0.3, 1) var(--w, 0s) both;
  }

  /* On hover only the letters rewrite, starting right away (no landing to wait for). */
  .site-mark.rewrite .site-mark-stroke {
    animation: draw-stroke var(--d, 0.3s) cubic-bezier(0.6, 0.05, 0.3, 1) calc(var(--w, 0.5s) - 0.5s) both;
  }

  @keyframes land {
    0% {
      opacity: 0;
      transform: translateY(-60%) scale(0.85);
    }

    55% {
      opacity: 1;
      transform: translateY(0) scale(1.1, 0.88);
    }

    75% {
      transform: translateY(0) scale(0.96, 1.04);
    }

    100% {
      transform: translateY(0) scale(1);
    }
  }

  @keyframes draw-stroke {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  /* Both labels share one grid cell, so swapping them never shifts the header. */
  .site-name-text {
    display: grid;
  }

  .site-name-default,
  .site-name-hover {
    grid-area: 1 / 1;
    transition: opacity 0.15s;
  }

  /* The name matches the mark's navy, so the two read as one lockup. */
  .site-name-default {
    color: var(--color-accent-strong);
  }

  .site-name-hover {
    opacity: 0;
    font-weight: 400;
    color: var(--color-accent);
  }

  /* On hover (not on the homepage itself), the name becomes "Return to homepage". */
  .site-name:not(.is-home):hover .site-name-default,
  .site-name:not(.is-home):focus-visible .site-name-default {
    opacity: 0;
  }

  .site-name:not(.is-home):hover .site-name-hover,
  .site-name:not(.is-home):focus-visible .site-name-hover {
    opacity: 1;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-links a {
    font-size: 0.9375rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .nav-links a[aria-current="page"] {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .nav-links a.nav-cta {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.125rem;
    border-radius: var(--radius);
    background: var(--color-accent-strong);
    color: var(--color-surface);
    font-weight: 600;
  }

  .nav-links a.nav-cta:hover {
    background: var(--color-accent-strong-hover);
    color: var(--color-surface);
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-text);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .hamburger {
    position: relative;
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .hamburger::before { top: -6px; }
  .hamburger::after { top: 6px; }

  .menu-toggle[aria-expanded="true"] .hamburger { background: transparent; }
  .menu-toggle[aria-expanded="true"] .hamburger::before { transform: rotate(45deg); top: 0; }
  .menu-toggle[aria-expanded="true"] .hamburger::after { transform: rotate(-45deg); top: 0; }

  @media (max-width: 720px) {
    .menu-toggle {
      display: inline-flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--page-gutter) 1rem;
      background: var(--color-background);
      border-bottom: 1px solid var(--color-border);
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links a {
      display: flex;
      align-items: center;
      min-height: 48px;
      border-bottom: 1px solid var(--color-border);
    }

    .nav-links a.nav-cta {
      justify-content: center;
      margin-top: 0.75rem;
      border-bottom: none;
    }
  }

  /* Footer: tucked under the page — a thin edge and a soft shadow cast onto a flat grey band. */
  .site-footer {
    margin-top: 5rem;
    padding: 3.5rem 0;
    border-top: 1px solid var(--color-footer-edge);
    background: var(--color-footer-background);
    box-shadow: inset 0 18px 22px -16px var(--color-footer-shadow);
    color: var(--color-text);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem 2rem;
  }

  .footer-title {
    margin: 0 0 0.5rem;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-text);
  }

  .footer-details {
    margin: 0;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .footer-pitch {
    flex: 1 1 22rem;
  }

  .footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer-actions .button-secondary {
    background: var(--color-surface);
  }

</style>
