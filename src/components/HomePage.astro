---
// The homepage, shared by / and each tailored /for homepage. Only the emphasis changes
// (headline, intro, stats, the first set of case studies, the resume PDF); How I work and
// the Experience strip are identical everywhere, because the facts never vary.
import { getCollection } from 'astro:content';
import CaseStudyCard from './CaseStudyCard.astro';
import Hero from './Hero.astro';
import { contact, experience, cycle, homeLanes, workThesis, type Lane, type Proof } from '../data/site';

interface Props {
  stats: Proof[];
  /** Small label above the headline (the /for homepages). */
  eyebrow?: string;
  /** Added to the end of the photo caption's first line (the /for homepages). */
  domain?: string;
  /** Resume PDF for this page's download buttons. */
  resumePdf?: string;
  /** Hand-picked case studies shown first, as a "Start here" focus (the /for homepages). */
  startHere?: Lane;
}

const { stats, eyebrow, domain, resumePdf = contact.resumePdf, startHere } = Astro.props;

const entries = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);
const bySlug = new Map(entries.map((entry) => [entry.slug, entry]));
const laneList = startHere
  ? [{ ...startHere, label: 'Start here' }, ...homeLanes.filter((lane) => lane.key !== startHere.key)]
  : homeLanes;
const lanes = laneList.map((lane) => ({
  ...lane,
  entries: lane.flag
    ? entries.filter((entry) => entry.data.featured[lane.flag!])
    : (lane.caseStudies ?? []).map((slug) => {
        const entry = bySlug.get(slug);
        if (!entry) throw new Error(`Unknown case study "${slug}" in lane "${lane.key}"`);
        return entry;
      }),
}));
---


  <Hero stats={stats} eyebrow={eyebrow} resumePdf={resumePdf} domain={domain}>
    <Fragment slot="headline"><slot name="headline" /></Fragment>
    <slot />
  </Hero>

  <div class="band band-tint">
  <section class="container" id="work">
    <div class="pivot">
      <div class="pivot-head">
        <h2>The work behind the numbers.</h2>
        <p class="section-intro">Pick a focus to see the most relevant work first — or browse it all.</p>
      </div>

      <div class="lane-buttons" role="group" aria-label="Focus the work">
        {lanes.map((lane, i) => (
          <button type="button" data-lane-button={lane.key} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`lane-${lane.key}`}>{lane.label}</button>
        ))}
      </div>

      {lanes.map((lane, i) => (
        <div class="lane" id={`lane-${lane.key}`} data-lane={lane.key} hidden={i !== 0}>
          <p class="lane-line">{lane.line}</p>
          <div class="work-grid">
            {lane.entries.map((entry) => <CaseStudyCard entry={entry} />)}
          </div>
          <div class="pivot-foot">
            <a href="/portfolio" class="button button-secondary">See all case studies</a>
          </div>
        </div>
      ))}
    </div>
  </section>
  </div>

  <div class="band">
  <section class="container how-i-work" aria-labelledby="how-i-work-title">
    <div class="how-i-work-head">
      <h2 id="how-i-work-title">How I work</h2>
      <p class="section-intro">{workThesis}</p>
    </div>
    <ol class="cycle-list">
      {cycle.map((step, i) => (
        <li>
          <span class="cycle-step" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.short}</p>
        </li>
      ))}
    </ol>
    <p><a href="/about/#how-i-work">What that looks like in practice</a></p>
  </section>
  </div>

  <div class="band band-tint">
  <section class="container experience" id="experience">
    <div class="experience-intro">
      <h2>Experience</h2>
      <p class="section-intro">The compressed version. The resume has the same numbers; the case studies have the full story.</p>
      <a href={resumePdf} class="button button-secondary" download>Download resume</a>
    </div>
    <dl class="experience-list">
      {experience.map((job) => (
        <div class="job">
          <dt>{job.company}</dt>
          <dd class="job-summary">{job.role} · {job.summary}</dd>
          <dd class="job-years">{job.years}</dd>
        </div>
      ))}
    </dl>
  </section>
  </div>

<script>
  const buttons = document.querySelectorAll('[data-lane-button]');
  const panels = document.querySelectorAll('.pivot [data-lane]');

  function showLane(key) {
    buttons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.laneButton === key));
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.lane !== key;
    });
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => showLane(button.dataset.laneButton));
  });
</script>

<style>


  .pivot {
    display: flex;
    flex-direction: column;
  }

  .pivot-head {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }


  .lane-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 1rem;
  }

  .lane-buttons button {
    min-height: 48px;
    padding: 0 1.25rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }

  .lane-buttons button:hover {
    border-color: var(--color-accent-strong);
    box-shadow: inset 0 0 0 1px var(--color-accent-strong);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }

  .lane-buttons button[aria-pressed="true"] {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-surface);
  }

  /* The content the buttons change, boxed so the relationship is obvious. */
  .lane {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem;
    border: 1px solid var(--color-accent-border);
    border-radius: 16px;
    background: var(--color-surface);
  }

  .lane-line {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .pivot-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
  }

  .how-i-work {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .how-i-work-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: var(--max-width-reading);
  }

  .cycle-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.5rem;
    list-style: none;
  }

  /* Step numbers show the order; a grey label, not content. */
  .cycle-step {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .cycle-list li {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 2px solid var(--color-text);
  }

  .experience {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 4rem;
  }

  .experience-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }


  .experience-list {
    border-bottom: 1px solid var(--color-border);
  }

  .job {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr) 6rem;
    gap: 1.25rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .job:first-child {
    border-top-color: var(--color-text);
  }

  .job dt {
    font-weight: 700;
  }

  .job-summary {
  }

  .job-years {
    text-align: right;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cycle-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 800px) {
    .lane {
      padding: 1.5rem;
    }

    .lane-buttons button {
      flex: 1 1 auto;
    }

    .experience {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .job {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.25rem 1rem;
    }

    .job-summary {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (max-width: 560px) {

    .work-grid,
    .cycle-list {
      grid-template-columns: 1fr;
    }
  }
</style>
