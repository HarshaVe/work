---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Hero from '../components/Hero.astro';
import { capabilities, contact, experience, headlineStats, homeLanes } from '../data/site';

const entries = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);
const bySlug = new Map(entries.map((entry) => [entry.slug, entry]));
const lanes = homeLanes.map((lane) => ({
  ...lane,
  entries: lane.flag
    ? entries.filter((entry) => entry.data.featured[lane.flag!])
    : (lane.caseStudies ?? []).map((slug) => {
        const entry = bySlug.get(slug);
        if (!entry) throw new Error(`Unknown case study "${slug}" in lane "${lane.key}"`);
        return entry;
      }),
}));
---

<Layout title="Home">
  <Hero stats={headlineStats}>
    <Fragment slot="headline">Impact isn’t accidental—<br /><span class="keep-together">it’s crafted.</span></Fragment>
    <p class="lede">Great experiences are how companies earn trust, whether it's an admin configuring an enterprise platform, a buyer comparing hundreds of thousands of products, or someone buying a vehicle online and caring for it for years after.</p>
    <p class="lede">I also build and scale teams that are empowered to deliver the remarkable. At Bosch, I started as employee zero for our North American design org, and grew a ~120-person design practice. At Siemens, I took UX, research, and content strategy from 5 people to 70, across seven countries, growing every IC and future leader along the way.</p>
    <p class="lede">And I'm still close to the pixels, hands-on in shaping how AI gets designed, built, and deployed, so it serves what people actually need, not just what the technology can do.</p>
  </Hero>

  <div class="band band-tint">
  <section class="container" id="work">
    <div class="pivot">
      <div class="pivot-head">
        <h2>The work behind the numbers.</h2>
        <p class="section-intro">Pick a focus to see the most relevant work first — or browse it all.</p>
      </div>

      <div class="lane-buttons" role="group" aria-label="Focus the work">
        {lanes.map((lane, i) => (
          <button type="button" data-lane-button={lane.key} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`lane-${lane.key}`}>{lane.label}</button>
        ))}
      </div>

      {lanes.map((lane, i) => (
        <div class="lane" id={`lane-${lane.key}`} data-lane={lane.key} hidden={i !== 0}>
          <p class="lane-line">{lane.line}</p>
          <div class="work-grid">
            {lane.entries.map((entry) => <CaseStudyCard entry={entry} />)}
          </div>
          <div class="pivot-foot">
            <a href="/portfolio" class="button button-secondary">See all case studies</a>
          </div>
        </div>
      ))}
    </div>
  </section>
  </div>

  <div class="band">
  <section class="container capabilities" aria-labelledby="kodawari-title">
    <div class="capabilities-head">
      <h2 id="kodawari-title">How I work</h2>
      <p class="section-intro"><a href="https://exploringkodawari.blog/what-is-kodawari/" target="_blank" rel="noopener noreferrer">Kodawari<span class="visually-hidden"> (opens in a new tab)</span></a> is the Japanese idea of an uncompromising, personal commitment to craft. It’s how I believe design delivers its best results: the standard isn’t set by the deadline or the org chart; it’s set by the person on the other side of the experience.</p>
    </div>
    <ol class="capability-grid">
      {capabilities.map((c, i) => (
        <li class="capability">
          <span class="capability-step" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{c.title}</h3>
          <p>{c.text}</p>
        </li>
      ))}
    </ol>
  </section>
  </div>

  <div class="band band-tint">
  <section class="container experience" id="experience">
    <div class="experience-intro">
      <h2>Experience</h2>
      <p class="section-intro">The compressed version. The résumé has the same numbers; the case studies have the full story.</p>
      <a href={contact.resumePdf} class="button button-secondary" download>Download résumé (PDF)</a>
    </div>
    <dl class="experience-list">
      {experience.map((job) => (
        <div class="job">
          <dt>{job.company}</dt>
          <dd class="job-summary">{job.role} · {job.summary}</dd>
          <dd class="job-years">{job.years}</dd>
        </div>
      ))}
    </dl>
  </section>
  </div>
</Layout>

<script>
  const buttons = document.querySelectorAll('[data-lane-button]');
  const panels = document.querySelectorAll('.pivot [data-lane]');

  function showLane(key) {
    buttons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.laneButton === key));
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.lane !== key;
    });
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => showLane(button.dataset.laneButton));
  });
</script>

<style>

  /* Full-width bands alternate off-white and light blue-grey so each topic reads as a new section. */
  .band {
    padding: 5rem 0;
  }

  .band-tint {
    background: var(--color-accent-soft);
  }

  /* When the page ends on a tinted band, let it meet the footer directly. */
  :global(main:has(> .band:last-child) + .site-footer) {
    margin-top: 0;
  }

  .keep-together {
    white-space: nowrap;
  }

  .pivot {
    display: flex;
    flex-direction: column;
  }

  .pivot-head {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }


  .lane-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 1rem;
  }

  .lane-buttons button {
    min-height: 48px;
    padding: 0 1.25rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }

  .lane-buttons button:hover {
    border-color: var(--color-accent-strong);
    box-shadow: inset 0 0 0 1px var(--color-accent-strong);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }

  .lane-buttons button[aria-pressed="true"] {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-surface);
  }

  /* The content the buttons change, boxed so the relationship is obvious. */
  .lane {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem;
    border: 1px solid var(--color-accent-border);
    border-radius: 16px;
    background: var(--color-surface);
  }

  .lane-line {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .pivot-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
  }

  .capabilities {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .capabilities-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }


  .capability-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    list-style: none;
  }

  .capability-step {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .capability {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 2px solid var(--color-text);
  }


  .capability p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .experience {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 4rem;
  }

  .experience-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }


  .experience-list {
    border-bottom: 1px solid var(--color-border);
  }

  .job {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr) 6rem;
    gap: 1.25rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .job:first-child {
    border-top-color: var(--color-text);
  }

  .job dt {
    font-weight: 700;
  }

  .job-summary {
  }

  .job-years {
    text-align: right;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .work-grid,
    .capability-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 800px) {
    .lane {
      padding: 1.5rem;
    }

    .lane-buttons button {
      flex: 1 1 auto;
    }

    .experience {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .job {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.25rem 1rem;
    }

    .job-summary {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (max-width: 560px) {

    .band {
      padding: 3.5rem 0;
    }

    .work-grid,
    .capability-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
