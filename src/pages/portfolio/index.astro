---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';

const portfolioEntries = await getCollection('portfolio');
const sortedEntries = portfolioEntries.sort((a, b) => a.data.order - b.data.order);

const filters = [
  { key: 'all', label: 'All work' },
  { key: 'systems', label: 'Design systems' },
  { key: 'enterprise', label: 'Enterprise' },
  { key: 'ai', label: 'AI / ML' },
  { key: 'regulated', label: 'Regulated industries' },
  { key: 'vehicle', label: 'Mobility' },
  { key: 'commerce', label: 'Commerce & conversion' },
];
---

<Layout title="Work" description="Case studies from 25+ years leading design across Siemens, Bosch, VMware, GM, and the CDC.">
  <PageHeader
    eyebrow="Case studies"
    title="Work"
    lede="Selected work from 25+ years leading design teams — each told as situation, task, action, and results."
  />

  <section class="container">
    <div class="filter-bar" role="group" aria-label="Filter case studies">
      {filters.map((f, i) => (
        <button type="button" class="filter-button" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label}
        </button>
      ))}
    </div>

    <div class="work-grid">
      {sortedEntries.map((entry) => (
        <div
          class="work-item"
          data-regulated={String(entry.data.featured.regulated)}
          data-systems={String(entry.data.featured.systems)}
          data-enterprise={String(entry.data.featured.enterprise)}
          data-ai={String(entry.data.featured.ai)}
          data-vehicle={String(entry.data.featured.vehicle)}
          data-commerce={String(entry.data.featured.commerce)}
        >
          <CaseStudyCard entry={entry} />
        </div>
      ))}
    </div>

    <p class="no-results" hidden>No case studies match that filter yet.</p>
  </section>
</Layout>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .filter-button {
    min-height: 44px;
    padding: 0 1.125rem;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    border-radius: 999px;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }

  .filter-button:hover {
    border-color: var(--color-accent-strong);
    box-shadow: inset 0 0 0 1px var(--color-accent-strong);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }

  .filter-button[aria-pressed="true"] {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-surface);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem 2rem;
  }

  /* Let each card fill its grid cell so the "Read the case study" links line up. */
  .work-item {
    display: flex;
  }

  .work-item > :global(.card) {
    flex: 1;
  }

  .no-results {
    padding: 2rem 0;
    font-style: italic;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .work-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll('.filter-button');
  const items = document.querySelectorAll('.work-item');
  const noResults = document.querySelector('.no-results');

  function applyFilter(filter) {
    let visibleCount = 0;

    buttons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
    });

    items.forEach((item) => {
      const matches = filter === 'all' || item.dataset[filter] === 'true';
      item.hidden = !matches;
      if (matches) visibleCount++;
    });

    if (noResults) noResults.hidden = visibleCount > 0;
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      applyFilter(button.dataset.filter);
      const url = new URL(window.location.href);
      if (button.dataset.filter === 'all') url.searchParams.delete('filter');
      else url.searchParams.set('filter', button.dataset.filter);
      history.replaceState(null, '', url);
    });
  });

  const requested = new URLSearchParams(window.location.search).get('filter');
  if (requested && Array.from(buttons).some((button) => button.dataset.filter === requested)) {
    applyFilter(requested);
  }
</script>
