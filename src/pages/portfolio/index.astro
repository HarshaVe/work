---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const portfolioEntries = await getCollection('portfolio');
const sortedEntries = portfolioEntries.sort((a, b) => a.data.order - b.data.order);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Portfolio' }
];

const actionLink = { label: '→ View full resume', href: '/resume' };

const filters = [
  { key: 'all', label: 'All Work' },
  { key: 'regulated', label: 'Regulated Industries' },
  { key: 'systems', label: 'Design Systems' },
  { key: 'enterprise', label: 'Enterprise' },
  { key: 'ai', label: 'AI / ML' },
];
---

<Layout title="Portfolio" breadcrumbs={breadcrumbs} actionLink={actionLink}>
  <h1>Portfolio</h1>
  <p class="intro">Selected work from 25+ years leading design teams across regulated industries, enterprise B2B, and emerging technology.</p>

  <div class="filter-bar" role="group" aria-label="Filter portfolio by category">
    {filters.map((f, i) => (
      <button
        class="filter-button"
        data-filter={f.key}
        aria-pressed={i === 0 ? "true" : "false"}
      >
        {f.label}
      </button>
    ))}
  </div>

  <ul class="portfolio-list">
    {sortedEntries.map((entry) => (
      <li
        class="portfolio-list-item"
        data-regulated={entry.data.featured.regulated}
        data-systems={entry.data.featured.systems}
        data-enterprise={entry.data.featured.enterprise}
        data-ai={entry.data.featured.ai}
      >
        {entry.data.heroImage && (
          <a href={`/portfolio/${entry.slug}`} class="portfolio-thumbnail">
            <img src={entry.data.heroImage} alt={entry.data.title} />
          </a>
        )}
        <div class="portfolio-list-content">
          <a href={`/portfolio/${entry.slug}`} class="portfolio-title">{entry.data.title}</a>
          <span class="portfolio-company"> — {entry.data.company}</span>
          <p>{entry.data.description}</p>
        </div>
      </li>
    ))}
  </ul>

  <p class="no-results" hidden>No case studies match that filter yet.</p>
</Layout>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 2rem 0;
  }

  .filter-button {
    padding: 0.5rem 1.1rem;
    border: 1px solid #d0d0d0;
    background: #fff;
    border-radius: 999px;
    font-size: 0.9rem;
    color: #444;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }

  .filter-button:hover {
    border-color: #2c5282;
  }

  .filter-button[aria-pressed="true"] {
    background: #2c5282;
    border-color: #2c5282;
    color: #fff;
  }

  .no-results {
    color: #777;
    font-style: italic;
    padding: 2rem 0;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
  const items = document.querySelectorAll<HTMLLIElement>('.portfolio-list-item');
  const noResults = document.querySelector<HTMLElement>('.no-results');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      button.setAttribute('aria-pressed', 'true');

      const filter = button.dataset.filter;
      let visibleCount = 0;

      items.forEach((item) => {
        const matches = filter === 'all' || item.dataset[filter as string] === 'true';
        item.hidden = !matches;
        if (matches) visibleCount++;
      });

      if (noResults) noResults.hidden = visibleCount > 0;
    });
  });
</script>