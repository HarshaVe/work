---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProtectedEmail from '../../components/ProtectedEmail.astro';
import JumpNav from '../../components/JumpNav.astro';
import { contact } from '../../data/site';

// Master resume. Numbers and phrasing here must match CLAUDE.md, the homepage, and the case studies.
const skills = [
  { title: 'Design org leadership & scaling', text: 'Leading large, distributed design orgs (teams of 100+, director-level reports, 16 years leading design orgs) · Managing managers · Org design & succession · Player/coach leadership · Culture & mentoring · Partnership with Product & Engineering · Executive alignment · Leading through inflection points' },
  { title: 'AI-native design practice', text: 'Agentic & conversational UX · LLM integration & prompt design · Validation frameworks for LLM outputs · AI tooling adoption & workflow redesign · Building org-wide AI fluency · AI-assisted prototyping (Figma Make)' },
  { title: 'Design systems & quality', text: 'Design system ownership at enterprise scale (100K+ pages, 150+ sites consolidated, 3,000+ creators) · Tokens, components & governance · Definitions of done · Launch review frameworks · Accessibility & privacy standards' },
  { title: 'Growth, commerce & conversion', text: 'Marketing & purchase funnel design · Marketplace & e-commerce UX · Vehicle configurators · Experimentation (A/B, multivariate) · Data-informed iteration · Enterprise workflows (CPQ)' },
  { title: 'Research & craft', text: 'UX research & research operations · Usability testing · Measurement frameworks · Behavioral science · Interaction & visual design · Data visualization · Web, native mobile & in-vehicle HMI' },
  { title: 'Tools', text: 'Figma · FigJam · Figma Make · Microsoft Copilot · Miro · Dovetail · UserTesting · Jira · Notion · Adobe CC · HTML/CSS' },
];

interface Job {
  role: string;
  company: string;
  dates: string;
  summary: string;
  groups: { heading?: string; items: string[] }[];
}

const jobs: Job[] = [
  {
    role: 'Global Director, Experience Design & Research',
    company: 'Siemens',
    dates: 'April 2023 – Present',
    summary: 'Grew and lead a global UX, research, and content strategy organization from 5 to 70 people across seven countries, within a complex B2B ecosystem spanning industrial automation and AI-driven customer experiences.',
    groups: [
      { heading: 'Platform & commerce', items: [
        'Own and govern the One Siemens design system. Put the first- and third-party marketplace at the center of Siemens’ digital experience and integrated the marketing site and business-unit selling channels around it: a single explorable catalog of hundreds of thousands of Siemens and third-party products, across 100K+ pages, consolidating 150+ sites into one',
        'Own the design of the marketing and purchase funnels, partnering with Product and Engineering to improve usability and conversion through experimentation and data-informed iteration',
        'Set governance for 3,000+ internal creators, and organized the catalog so customers navigate by their own needs rather than Siemens’ org structure',
      ] },
      { heading: 'AI-native practice', items: [
        'Led design and research for an AI-powered product finder that increased conversion 23% and engagement 28%',
        'Led strategy and training for an AI research agent on Microsoft Copilot that unified research repositories and lets stakeholders query insights in natural language, increasing data utilization 20% and cutting time-to-insight 34%',
      ] },
      { heading: 'Organization', items: [
        'Manage managers (4 direct reports) and partner as a peer to Product and Engineering on sprint planning, backlog priorities, and technical tradeoffs',
        'Built a career-growth tool that combines industry best-practice frameworks with self- and manager-scoring, helping every level of the team find and develop the skills for the roles they aspire to',
      ] },
    ],
  },
  {
    role: 'Senior Manager UX, Smart Vehicle',
    company: 'Amazon',
    dates: 'September 2022 – January 2023',
    summary: 'Directed design and research for Amazon’s next-gen in-vehicle platform, spanning embedded commerce, media, and personalization.',
    groups: [{ items: [
      'Led a 13-person team (3 direct reports) across UX design, research, conversational design, and visual design in Seattle, San Francisco, and Detroit',
      'Designed vehicle-specific commerce and monetization features, balancing safety, usability, and business impact within hardware-freeze timelines',
      'Introduced leaner design processes that increased collaboration and cut delivery timelines 12%',
    ] }],
  },
  {
    role: 'Senior Director User Experience Design & Research',
    company: 'VMware',
    dates: 'April 2021 – September 2022',
    summary: 'Led design, research, and experience strategy for mission-critical enterprise tools through VMware’s Sub-to-SaaS transformation, a company-level inflection point.',
    groups: [{ items: [
      'Modernized the CPQ (configure-price-quote) platform, cutting time-on-task 30% and accelerating deal velocity across 35,000+ users, in direct partnership with Product and Engineering',
      'Re-platformed digital systems for a post-COVID hybrid workforce while holding 75%+ CSAT and reducing support load 20%',
      'Built a 75-person distributed team (9 direct reports) across UX strategy, design, research, content design, and design operations in Palo Alto, Sofia, and Bangalore',
      'Designed a centralized experience scorecard and measurement framework adopted company-wide',
      'Operated as player/coach, contributing directly to critical design work while mentoring senior ICs and scaling leadership capacity',
    ] }],
  },
  {
    role: 'Director, Digital Brand, UX and Research',
    company: 'CARFAX',
    dates: 'October 2019 – April 2021',
    summary: 'Led UX, brand, and research across consumer touchpoints for one of the most recognized names in automotive.',
    groups: [{ items: [
      'Led an end-to-end product redesign that delivered a 7% conversion lift and a 26% reduction in development churn',
      'Elevated the brand across consumer touchpoints, from mobile apps to dealer products, with a repeatable design process and research cadence',
      'Led a 30-person team (3 direct reports) across UX design, research, graphic design, and design operations',
    ] }],
  },
  {
    role: 'Head of Design, North America',
    company: 'Robert Bosch, LLC',
    dates: 'October 2016 – October 2019',
    summary: 'Joined as employee zero and built Bosch’s North American internal design consultancy into a ~120-person practice (5 direct reports, 90 indirect).',
    groups: [{ items: [
      'Ran an internal design agency and a design-thinking incubator that took non-design teams from early concept to launched products with startup-level agility',
      'Led research and design of an AI/ML-powered radio and infotainment system, trading off physical controls and screen to lower glance times and improve customer sentiment while cutting hardware cost',
      'Designed connected-vehicle and consumer services, including fleet maintenance, community and parking apps, and keyless access, plus B2C e-commerce for Power Tools',
      'Drove service design initiatives that saved $6M while strengthening key industry partnerships',
    ] }],
  },
  {
    role: 'User Experience Manager',
    company: 'General Motors',
    dates: 'September 2014 – October 2016',
    summary: 'Led the design of the full owner journey across seven global brands, from brand sites through ownership and trade-in.',
    groups: [{ items: [
      'Led the design of brand websites, the vehicle configurator, purchase and finance flows, OnStar onboarding, and ownership through maintenance and trade-in',
      'Set purchase and finance interaction patterns adopted across Chevrolet, Cadillac, Buick, GMC, Opel, Vauxhall, and OnStar',
      'Built a unified, pattern-driven design system that launched seven mobile apps in 23 languages within one year, with OnStar, CarPlay, and Android Auto integration',
      'Created a new in-app services revenue stream exceeding $1M in its first year',
      'Scaled and led a 140-person multidisciplinary team across research, UX, visual design, and front-end development in Detroit and Austin',
    ] }],
  },
  {
    role: 'Design Manager',
    company: 'Air Mobility Command',
    dates: 'May 2013 – September 2014',
    summary: 'Led consulting teams delivering mission-critical planning and decision-support systems for U.S. Air Force operations.',
    groups: [{ items: [
      'Directed end-to-end design for high-urgency planning tools supporting 1,200+ daily missions, generating $2M+ in operational savings',
      'Established command-wide human interaction design guidelines based on research-driven principles',
    ] }],
  },
  {
    role: 'User Experience and Analytics Manager',
    company: 'Centers for Disease Control and Prevention',
    dates: 'December 2010 – May 2013',
    summary: 'Led UX, research, and analytics for the National Center for HIV/AIDS, Viral Hepatitis, STD, and TB Prevention: 18+ sites and tools with 70M+ page views a year.',
    groups: [{ items: [
      'Redesigned HIVTest.org as the center’s first responsive mobile site, under HIPAA and Section 508, lifting HIV testing conversion 70%',
      'Launched the center’s first mobile app',
      'Built the enterprise measurement framework used for data-driven experience decisions at national scale',
    ] }],
  },
];

const priorExperience = [
  { title: 'Interaction Designer', detail: 'Blackbaud · Nov 2007 – Dec 2010' },
  { title: 'Product Manager & Design Engineer', detail: 'Morris Digitalworks · Feb 2004 – Oct 2007' },
  { title: 'Research Analyst', detail: 'Mirant, LLC · Aug 2001 – Oct 2003' },
  { title: 'Designer', detail: 'SoftSys, LLC · May 1999 – Jul 2001' },
];

const thoughtLeadership = [
  { title: 'Leading Teams through AI', detail: "Panel speaker, UX Researchers' Guild, Dec 2025" },
  { title: 'IDC MarketScape: Digital B2B Ecosystems and Marketplaces', detail: 'Featured expert, IDC, Sept 2025' },
  { title: 'Forrester: Leveraging AI for E-commerce in B2B Organizations', detail: 'Featured expert, Forrester, 2025' },
  { title: 'Creating a Human-Centered Company', detail: 'AV18 Autonomous Vehicle Conference, 2018' },
  { title: 'Designing the Human Experience', detail: 'Automotive Cockpit HMI, 2018' },
  { title: 'Five Agile Challenges for Distributed Teams', detail: 'AgileConnection/TechWell, 2014' },
  { title: 'Gaming & Mobile for Public Health', detail: 'CDC NPIN Health Webcast, 2013' },
  { title: 'Usability in Public Health', detail: 'National HIV Prevention Conference, 2011' },
];

const education = [
  { title: 'Bachelor of Science, Information Technology', detail: 'American InterContinental University, 2001' },
  { title: 'Decision by Design', detail: 'Farnam Street, 2025' },
  { title: 'Google AI Essentials', detail: 'Google, 2025' },
  { title: 'Behavioral Design', detail: 'Irrational Labs, 2024' },
  { title: 'UX Research certificate', detail: 'University of Denver, 2016' },
  { title: 'Certified Agile Product Owner & Scrum Master', detail: 'Scrum Alliance, 2009' },
];

const sections = [
  { id: 'intro', label: 'Summary' },
  { id: 'experience', label: 'Experience' },
  { id: 'skills', label: 'Skills' },
  { id: 'thought-leadership', label: 'Thought leadership' },
  { id: 'education', label: 'Education & certifications' },
];
---
<Layout title="Resume" description="Resume of Harsha Vemulapalli, design executive with 25+ years building and leading design and research organizations.">
  <PageHeader
    eyebrow="Resume"
    title="Harsha Vemulapalli"
    lede="Design executive with 25+ years of experience, 16 of them leading and scaling design organizations with director-level reports. I build AI-native design and research practices, and the quality systems that let distributed teams ship at a consistently high bar, across enterprise platforms, commerce, connected vehicles, and regulated public health. Currently leading a 70-person UX, research, and content strategy organization at Siemens across seven countries."
  >
    <p class="contact-line">
      {contact.location} · <ProtectedEmail /> · <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="print-only"> ({contact.linkedin.replace('https://www.', '')})</span></a><span class="print-only"> · harshav.com</span>
    </p>
    <div class="button-row no-print">
      <a href="/contact" class="button button-primary">Get in touch</a>
      <a href={contact.resumePdf} class="button button-secondary" download>Download resume</a>
    </div>
  </PageHeader>

  <div class="container resume has-rail">
    <JumpNav label="Resume sections" items={sections.map((s) => ({ href: `#${s.id}`, label: s.label }))} />

    <div class="resume-body">
      <section id="experience" class="resume-section">
        <h2>Experience</h2>
        {jobs.map((job) => (
          <article class="job">
            <div class="job-head">
              <h3>{job.role}</h3>
              <p class="job-meta"><strong>{job.company}</strong> · {job.dates}</p>
            </div>
            <p class="job-summary">{job.summary}</p>
            {job.groups.map((group) => (
              <div class="job-group">
                {group.heading && <h4>{group.heading}</h4>}
                <ul>
                  {group.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </article>
        ))}

        <h3 class="subsection">Earlier experience</h3>
        <dl class="compact-list">
          {priorExperience.map((item) => (
            <div><dt>{item.title}</dt><dd>{item.detail}</dd></div>
          ))}
        </dl>
      </section>

      <section id="skills" class="resume-section">
        <h2>Skills</h2>
        <div class="skills-grid">
          {skills.map((s) => (
            <div class="skill">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="thought-leadership" class="resume-section">
        <h2>Thought leadership</h2>
        <dl class="compact-list">
          {thoughtLeadership.map((item) => (
            <div><dt>{item.title}</dt><dd>{item.detail}</dd></div>
          ))}
        </dl>
      </section>

      <section id="education" class="resume-section">
        <h2>Education &amp; certifications</h2>
        <dl class="compact-list">
          {education.map((item) => (
            <div><dt>{item.title}</dt><dd>{item.detail}</dd></div>
          ))}
        </dl>
      </section>
    </div>
  </div>
</Layout>

<style>
  .contact-line {
    color: var(--color-text-muted);
  }

  .resume {
    padding-top: 3rem;
  }

  .resume-body {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    max-width: var(--max-width-reading);
  }

  .resume-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .skill {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-large);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }


  .skill p {
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .job {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .job:first-of-type {
    border-top-color: var(--color-text);
  }

  .job-head {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }


  .job-meta {
    color: var(--color-text-muted);
  }

  .job-meta strong {
    color: var(--color-text);
  }

  .job-summary {
  }

  .job-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .job-group h4 {
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .job-group ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1.25rem;
  }

  .job-group li::marker {
    color: var(--color-text-muted);
  }

  .job + .job {
    margin-top: 1rem;
  }

  .subsection {
    margin-top: 1.5rem;
  }

  .compact-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .compact-list div {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--color-border);
  }

  .compact-list dt {
    font-weight: 600;
    line-height: 1.35;
  }

  .compact-list dd {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .resume {
      padding-top: 2rem;
    }

    .resume-body {
      padding-top: 1.5rem;
    }
  }

  /* The downloadable PDF is printed from this page (see scripts/build-resume-pdf.sh). */
  @media print {
    .resume {
      display: block;
      padding-top: 0;
    }

    .resume-body,
    .resume-section,
    .job,
    .job-group,
    .job-group ul {
      display: block;
      max-width: none;
    }

    .resume-section + .resume-section {
      margin-top: 1.25rem;
    }

    .resume-section h2 {
      margin-bottom: 0.25rem;
    }

    .job {
      padding-top: 0.5rem;
      margin-top: 0.5rem;
    }

    .job-summary,
    .job-group {
      margin-top: 0.25rem;
    }

    .job-group li,
    .job-head {
      break-inside: avoid-page;
    }

    .skills-grid {
      gap: 0.375rem 1.5rem;
      margin-top: 0.5rem;
    }

    .skill {
      padding: 0;
      border: none;
      gap: 0.125rem;
    }

    .compact-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .compact-list div {
      padding: 0.375rem 0;
    }

    .subsection {
      margin-top: 0.5rem;
    }
  }

  @media (max-width: 600px) {
    .skills-grid,
    .compact-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
