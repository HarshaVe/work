---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProtectedEmail from '../../components/ProtectedEmail.astro';
import JumpNav from '../../components/JumpNav.astro';
import { contact } from '../../data/site';

// Resume page. It must say the same thing as the downloadable PDFs in public/downloads/
// (supplied by Harsha): every bullet on any of those PDFs appears here, word for word,
// and titles, dates, team sizes, and metrics match them exactly. Order may differ.
const summary = 'Design and research executive with 25+ years of experience and 16 years leading multi-disciplinary organizations spanning product design, user research, design systems, content strategy, and localization. Grew Siemens’ global experience organization from 5 to 70 people across seven countries as a manager of managers, and led design through enterprise transformations at Siemens, VMware, and Bosch. AI-forward leader who sets org-wide AI strategy, from research agents and AI-driven localization to AI-assisted prototyping that ships to production, and pairs adoption with evaluation standards that protect research rigor. Holds the quality bar on accessibility and craft across enterprise SaaS, marketplace, and global multi-language platforms.';

const selectedImpact = [
  'Led experience design for Siemens Xcelerator Marketplace, a €9.4B digital sales channel that grew 19% in FY2025.',
  'Built and scaled design organizations of 70 (Siemens), 75 (VMware), ~120 (Bosch), and 140 (GM); grew 10+ designers into manager and director roles.',
  'Drove AI into the work itself: −34% time-to-insight with a research agent; +23% conversion and +28% engagement from an AI product finder.',
  'Own a $2M annual operating budget (excluding salaries), report to the SVP of eCommerce, and partner with Product and Engineering leadership on roadmap and tradeoffs.',
];

const skills = [
  { title: 'Organization Leadership', text: 'Manager of managers · Org design & scaling · Career paths & development programs · Remote, globally distributed teams · Psychological safety · Executive influence with Product & Engineering' },
  { title: 'AI Strategy & Adoption', text: 'Org-wide AI strategy · AI-assisted research synthesis · LLM evaluation & hallucination guardrails · Agentic workflows · Conversational UX · AI-assisted SDLC (Figma Make, Claude Code, React prototyping)' },
  { title: 'Research & Content', text: 'Research methodologies & ResearchOps · Insight-led product strategy · A/B testing & experimentation · Content strategy · Globalization & localization · AI-assisted translation' },
  { title: 'Quality & Systems', text: 'Design system governance & adoption · Accessibility (WCAG 2.1) · Design critique & review · Workflow automation for design & content compliance · Experience metrics & scorecards' },
];

interface Job {
  role: string;
  company: string;
  dates: string;
  summary?: string;
  groups: { heading?: string; items: string[] }[];
}

const jobs: Job[] = [
  {
    role: 'Global Director, Experience Design & Research',
    company: 'Siemens Digital Industries Software',
    dates: '2025 – Present',
    summary: 'Lead a 70-person organization across seven countries spanning UX design, research, content, localization, and design operations for Siemens Xcelerator Marketplace and global platforms.',
    groups: [{ items: [
      'Grew the organization from 5 to 70 (about 58 employees plus embedded contractors) through layers of senior managers; built a co-created skills framework and career growth tool that defines paths and expectations at every level.',
      'Set the org’s AI agenda: led a Microsoft Copilot research agent over a unified research repository (−34% time-to-insight, +20% data utilization) and a persona agent grounded in 80 interviews and 800+ surveys, now in daily use by research and approved for the extended design team, with accuracy and hallucination evaluation gating wider rollout.',
      'Led the One Siemens design system and governance model, consolidating 150+ sites, 100K+ pages, and 3,000+ content creators onto shared components and standards.',
      'Own localization, translation, and currency across 38 regions and 32 languages, where regions can carry multiple languages and currencies; use AI tools to tailor content to each market.',
      'Hold the quality bar at scale: no UI moves to development without an accessibility review, and built workflow automation that validates design-system compliance in design and brand, accessibility (WCAG 2.1), and content-strategy compliance in content authoring.',
      'Partnered as a peer with VP and SVP business leaders to grow the Xcelerator Marketplace, leading the experience from go-live; built third-party page templates that made the marketplace a home for partner products and services.',
    ] }],
  },
  {
    role: 'Director of User Experience, DISW',
    company: 'Siemens Digital Industries Software',
    dates: 'April 2023 – 2025',
    groups: [{ items: [
      'Owned UX, research, and content for Digital Industries Software’s web properties and purchase and finance funnels for technical and non-technical customers.',
      'Player/coach on an AI-powered product finder: cut scope to the customer’s next step, drew the initial layout, validated with 5-second and data-driven tests, prototyped in Figma Make, and shipped in React on Contentful; +23% conversion and +28% engagement, measured in Amplitude.',
      'Ran 2–3 A/B tests a week across the site with design, marketing, communications, and sales teams.',
    ] }],
  },
  {
    role: 'Senior Manager, UX Smart Vehicle',
    company: 'Amazon',
    dates: 'September 2022 – January 2023',
    groups: [{ items: [
      'Directed design and research for a multi-stakeholder vehicle platform with embedded commerce, media, and advertising; introduced leaner processes that cut timelines 12%.',
      'Led a 13-person team (3 direct reports) across UX design, research, conversational design, and visual design in Seattle, San Francisco, and Detroit',
      'Designed vehicle-specific commerce and monetization features, balancing safety, usability, and business impact within hardware-freeze timelines',
    ] }],
  },
  {
    role: 'Senior Director, User Experience Design & Research',
    company: 'VMware',
    dates: 'April 2021 – September 2022',
    groups: [{ items: [
      'Led design, research, experience strategy, and service design through VMware’s subscription-to-SaaS transformation.',
      'Redesigned mission-critical CPQ quoting workflows for 35,000+ users, cutting time-on-task 30% and accelerating SaaS deal velocity.',
      'Shipped an experience scorecard used by thousands of employees; re-platformed hybrid-work systems while holding 75%+ CSAT and reducing support load 20%.',
      'Developed senior ICs into leaders across a distributed team while contributing directly to critical design work.',
      'Built a 75-person distributed team (9 direct reports) across UX strategy, design, research, content design, and design operations in Palo Alto, Sofia, and Bangalore',
    ] }],
  },
  {
    role: 'Director, Digital Brand, UX and Research',
    company: 'CARFAX',
    dates: 'October 2019 – April 2021',
    summary: 'Led UX, brand, and research across consumer touchpoints for one of the most recognized names in automotive.',
    groups: [{ items: [
      'Led end-to-end product redesign for +7% conversion and −26% dev churn; established a research cadence that informed product and brand strategy.',
      'Elevated the brand across consumer touchpoints, from mobile apps to dealer products',
      'Led a 30-person team (3 direct reports) across UX design, research, graphic design, and design operations',
    ] }],
  },
  {
    role: 'Head of Design, North America',
    company: 'Robert Bosch, LLC',
    dates: 'October 2016 – October 2019',
    groups: [{ items: [
      'Built Bosch’s internal design consultancy from employee zero to ~120 people (5 direct, 90 indirect), and scaled a design thinking framework that let non-designers build human-centered solutions.',
      'Drove service design initiatives that saved $6M; led research and design for an AI/ML infotainment system that lowered hardware costs and glance times.',
      'Designed connected-vehicle and consumer services, including fleet maintenance, community and parking apps, and keyless access, plus B2C e-commerce for Power Tools',
    ] }],
  },
  {
    role: 'User Experience Manager',
    company: 'General Motors',
    dates: 'September 2014 – October 2016',
    summary: 'Led the design of the full owner journey across seven global brands, from brand sites through ownership and trade-in.',
    groups: [{ items: [
      'Built a pattern-driven global strategy that launched 7 mobile apps in 23 languages within one year across seven brands.',
      'Created an in-app services revenue stream exceeding $1M in its first year.',
      'Led the design of brand websites, the vehicle configurator, purchase and finance flows, OnStar onboarding, and ownership through maintenance and trade-in',
      'Set purchase and finance interaction patterns adopted across Chevrolet, Cadillac, Buick, GMC, Opel, Vauxhall, and OnStar',
      'Scaled and led a 140-person multidisciplinary team across research, UX, visual design, and front-end development in Detroit and Austin',
    ] }],
  },
  {
    role: 'Design Manager',
    company: 'Air Mobility Command (U.S. Air Force)',
    dates: 'May 2013 – September 2014',
    summary: 'Led consulting teams delivering mission-critical planning and decision-support systems for U.S. Air Force operations.',
    groups: [{ items: [
      'Directed end-to-end design for high-urgency planning tools supporting 1,200+ daily missions, generating $2M+ in operational savings',
      'Established command-wide human interaction design guidelines based on research-driven principles',
    ] }],
  },
  {
    role: 'User Experience and Analytics Manager',
    company: 'Centers for Disease Control and Prevention',
    dates: 'December 2010 – May 2013',
    summary: 'Led UX, research, and analytics for the National Center for HIV/AIDS, Viral Hepatitis, STD, and TB Prevention: 18+ sites and tools with 70M+ page views a year.',
    groups: [{ items: [
      'Redesigned HIVTest.org as the center’s first responsive mobile site, under HIPAA and Section 508, lifting HIV testing conversion 70%',
      'Launched the center’s first mobile app',
      'Built the enterprise measurement framework used for data-driven experience decisions at national scale',
    ] }],
  },
];

const priorExperience = [
  { title: 'Interaction Designer', detail: 'Blackbaud · Nov 2007 – Dec 2010' },
  { title: 'Product Manager', detail: 'Morris Digitalworks · Feb 2004 – Oct 2007' },
];

const thoughtLeadership = [
  { title: 'Leading Teams through AI', detail: 'Panel speaker, Research Guild, Dec 2025' },
  { title: 'IDC MarketScape: Digital B2B Ecosystems and Marketplaces', detail: 'Featured expert, IDC, Sept 2025' },
  { title: 'Forrester: Leveraging AI for B2B E-commerce', detail: 'Featured expert, Forrester, 2025' },
  { title: 'Creating a Human-Centered Company', detail: 'AV18 Autonomous Vehicle Conference, 2018' },
  { title: 'Designing the Human Experience', detail: 'Automotive Cockpit HMI, 2018' },
];

const education = [
  { title: 'B.S., Information Technology', detail: 'American InterContinental University' },
  { title: 'Decision by Design', detail: 'Farnam Street' },
  { title: 'Google AI Essentials', detail: 'Google' },
  { title: 'Behavioral Design', detail: 'Irrational Labs' },
  { title: 'UX Research', detail: 'University of Denver' },
  { title: 'Certified Scrum Product Owner & ScrumMaster', detail: 'Scrum Alliance' },
];

const sections = [
  { id: 'intro', label: 'Summary' },
  { id: 'impact', label: 'Selected impact' },
  { id: 'experience', label: 'Experience' },
  { id: 'skills', label: 'Skills' },
  { id: 'thought-leadership', label: 'Thought leadership' },
  { id: 'education', label: 'Education & certifications' },
];
---
<Layout title="Resume" description="Resume of Harsha Vemulapalli, design executive with 25+ years building and leading design and research organizations.">
  <PageHeader
    eyebrow="Resume"
    title="Harsha Vemulapalli"
    lede={summary}
  >
    <p class="contact-line">
      {contact.location} · <ProtectedEmail /> · <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="print-only"> ({contact.linkedin.replace('https://www.', '')})</span></a><span class="print-only"> · harshav.com</span>
    </p>
    <div class="button-row no-print">
      <a href="/contact" class="button button-primary">Get in touch</a>
      <a href={contact.resumePdf} class="button button-secondary" download>Download resume</a>
    </div>
  </PageHeader>

  <div class="container resume has-rail">
    <JumpNav label="Resume sections" items={sections.map((s) => ({ href: `#${s.id}`, label: s.label }))} />

    <div class="resume-body">
      <section id="impact" class="resume-section">
        <h2>Selected impact</h2>
        <div class="job-group">
          <ul>
            {selectedImpact.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>

      <section id="experience" class="resume-section">
        <h2>Experience</h2>
        {jobs.map((job) => (
          <article class="job">
            <div class="job-head">
              <h3>{job.role}</h3>
              <p class="job-meta"><strong>{job.company}</strong> · {job.dates}</p>
            </div>
            {job.summary && <p class="job-summary">{job.summary}</p>}
            {job.groups.map((group) => (
              <div class="job-group">
                {group.heading && <h4>{group.heading}</h4>}
                <ul>
                  {group.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </article>
        ))}

        <h3 class="subsection">Earlier experience</h3>
        <dl class="compact-list">
          {priorExperience.map((item) => (
            <div><dt>{item.title}</dt><dd>{item.detail}</dd></div>
          ))}
        </dl>
      </section>

      <section id="skills" class="resume-section">
        <h2>Skills</h2>
        <div class="skills-grid">
          {skills.map((s) => (
            <div class="skill">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="thought-leadership" class="resume-section">
        <h2>Thought leadership</h2>
        <dl class="compact-list">
          {thoughtLeadership.map((item) => (
            <div><dt>{item.title}</dt><dd>{item.detail}</dd></div>
          ))}
        </dl>
      </section>

      <section id="education" class="resume-section">
        <h2>Education &amp; certifications</h2>
        <dl class="compact-list">
          {education.map((item) => (
            <div><dt>{item.title}</dt><dd>{item.detail}</dd></div>
          ))}
        </dl>
      </section>
    </div>
  </div>
</Layout>

<style>
  .contact-line {
    color: var(--color-text-muted);
  }

  .resume {
    padding-top: 3rem;
  }

  .resume-body {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    max-width: var(--max-width-reading);
  }

  .resume-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .skill {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-large);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }


  .skill p {
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .job {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .job:first-of-type {
    border-top-color: var(--color-text);
  }

  .job-head {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }


  .job-meta {
    color: var(--color-text-muted);
  }

  .job-meta strong {
    color: var(--color-text);
  }

  .job-summary {
  }

  .job-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .job-group h4 {
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .job-group ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1.25rem;
  }

  .job-group li::marker {
    color: var(--color-text-muted);
  }

  .job + .job {
    margin-top: 1rem;
  }

  .subsection {
    margin-top: 1.5rem;
  }

  .compact-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .compact-list div {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--color-border);
  }

  .compact-list dt {
    font-weight: 600;
    line-height: 1.35;
  }

  .compact-list dd {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .resume {
      padding-top: 2rem;
    }

    .resume-body {
      padding-top: 1.5rem;
    }
  }

  /* The downloadable PDF is printed from this page (see scripts/build-resume-pdf.sh). */
  @media print {
    .resume {
      display: block;
      padding-top: 0;
    }

    .resume-body,
    .resume-section,
    .job,
    .job-group,
    .job-group ul {
      display: block;
      max-width: none;
    }

    .resume-section + .resume-section {
      margin-top: 1.25rem;
    }

    .resume-section h2 {
      margin-bottom: 0.25rem;
    }

    .job {
      padding-top: 0.5rem;
      margin-top: 0.5rem;
    }

    .job-summary,
    .job-group {
      margin-top: 0.25rem;
    }

    .job-group li,
    .job-head {
      break-inside: avoid-page;
    }

    .skills-grid {
      gap: 0.375rem 1.5rem;
      margin-top: 0.5rem;
    }

    .skill {
      padding: 0;
      border: none;
      gap: 0.125rem;
    }

    .compact-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .compact-list div {
      padding: 0.375rem 0;
    }

    .subsection {
      margin-top: 0.5rem;
    }
  }

  @media (max-width: 600px) {
    .skills-grid,
    .compact-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
