---
// Tailored homepages (unlisted: noindex, linked only from resumes and applications). Each is
// the full homepage with its own emphasis; see HomePage.astro. A visit here also sets the
// "lens" that Layout.astro uses to keep the rest of the visit pointed back at this page.
import Layout from '../../layouts/Layout.astro';
import HomePage from '../../components/HomePage.astro';
import { contact, focusPages, type FocusPage } from '../../data/site';

export function getStaticPaths() {
  return focusPages.map((page) => ({ params: { lane: page.key }, props: { page } }));
}

const { page } = Astro.props as { page: FocusPage };
const resumePdf = page.resumePdf ?? contact.resumePdf;
---

<Layout
  noindex
  isHome
  title={page.title ?? page.label}
  description={page.description ?? page.headline}
  resumePdf={resumePdf}
  image={`/og/${page.key}.png`}
  lens={{ home: `/for/${page.key}/`, resumePdf, caseStudies: page.caseStudies }}
>
  <HomePage stats={page.proof} eyebrow={page.eyebrow ?? page.label} domain={page.domain} resumePdf={resumePdf} startHere={page}>
    <Fragment slot="headline">{page.headline}</Fragment>
    {page.intro.map((paragraph) => <p class="lede">{paragraph}</p>)}
  </HomePage>
</Layout>
