---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

// Plain links to the main sections, each with a short note on what's there.
const destinations = [
  { href: '/portfolio', label: 'Case studies', note: 'the work, in depth' },
  { href: '/resume', label: 'Resume', note: 'the short version' },
  { href: '/about', label: 'About', note: 'how I got here and how I work' },
  { href: '/contact', label: 'Get in touch', note: 'if a link sent you here, I’d like to know' },
];
---

<Layout noindex title="Page not found" description="This page doesn't exist, or it has moved.">
  <PageHeader eyebrow="404" title="That page doesn’t exist, but these do." wideAside>
    <ul class="destinations section-intro">
      {destinations.map((d) => (
        <li><a href={d.href}>{d.label}</a>: {d.note}</li>
      ))}
    </ul>

    <figure class="photo-404" slot="aside">
      <img src="/images/404-hirshhorn.jpg" width="1120" height="840" alt="A gallery corridor curving out of view, lined with a layered, weathered artwork." />
      <figcaption class="figure-caption">Mark Bradford’s <cite>Pickett’s Charge</cite>, inside the Hirshhorn Museum, Gordon Bunshaft’s 1974 “brutalist donut” in Washington, DC. Photo by me.</figcaption>
    </figure>
  </PageHeader>
</Layout>

<style>
  .photo-404 {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
  }

  .photo-404 img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-large);
  }

  .destinations {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding-left: 1.25rem;
  }
</style>
