---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout noindex title="Page not found" description="This page doesn't exist, or it has moved.">
  <PageHeader eyebrow="Research finding #404" title="The page you wanted isn’t here.">
    <section class="glance finding" aria-label="Finding details">
      <dl>
        <div><dt>Severity</dt><dd>Low. Everything else on the site works.</dd></div>
        <div><dt>Frequency</dt><dd>Rare, but it happens to the best-tested sites.</dd></div>
        <div><dt>Likely cause</dt><dd>A link from before the site was rebuilt, or a typo in the address.</dd></div>
        <div><dt>Next step</dt><dd>Pick up where you meant to go:</dd></div>
      </dl>
    </section>
    <div class="button-row">
      <a href="/" class="button button-primary">Go to the homepage</a>
      <a href="/portfolio" class="button button-secondary">See the case studies</a>
      <a href="/resume" class="button button-secondary">Resume</a>
    </div>

    <!-- The header's navy circle with "404" set in Helvetica Bold (static, no animation). -->
    <svg class="mark-404" slot="aside" viewBox="5.5 5.5 89 89" role="img" aria-label="404">
      <path class="disc" d="M52 7 C77 8,93 27,92 51 C91 76,72 93,48 92 C24 91,7 73,8 49 C9 26,28 6,52 7 Z" />
      <text class="digits" x="50" y="51" text-anchor="middle" dominant-baseline="central">404</text>
    </svg>
  </PageHeader>
</Layout>

<style>
  .finding {
    margin-bottom: 0;
  }

  .mark-404 {
    display: block;
    width: 100%;
    max-width: 260px;
    overflow: visible;
  }

  .mark-404 .disc {
    fill: var(--color-accent-strong);
  }

  .mark-404 .digits {
    fill: var(--color-surface);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  /* On phones, show the mark first (above the headline) so it is seen. */
  @media (max-width: 800px) {
    .mark-404 {
      max-width: 120px;
    }

    :global(.page-header-aside) {
      order: -1;
    }
  }
</style>
