---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

// Plain links to the main sections, each with a short note on what's there.
const destinations = [
  { href: '/portfolio', label: 'Case studies', note: 'the work, in depth' },
  { href: '/resume', label: 'Resume', note: 'the short version' },
  { href: '/about', label: 'About', note: 'how I got here and how I work' },
  { href: '/contact', label: 'Get in touch', note: 'if a link sent you here, I’d like to know' },
];
---

<Layout noindex title="Page not found" description="This page doesn't exist, or it has moved.">
  <div class="hero-404">
  <PageHeader eyebrow="404" title="That page doesn’t exist, but these do.">
    <ul class="destinations section-intro">
      {destinations.map((d) => (
        <li><a href={d.href}>{d.label}</a>: {d.note}</li>
      ))}
    </ul>
    <p class="note">Mark Bradford’s <cite><a href="https://hirshhorn.si.edu/exhibitions/mark-bradford-picketts-charge/" target="_blank" rel="noopener noreferrer">Pickett’s Charge</a></cite><span class="visually-hidden"> (opens in a new tab)</span>, inside the Hirshhorn Museum, Gordon Bunshaft’s 1974 “brutalist donut” in Washington, DC. Photo by me.</p>
  </PageHeader>

  <figure class="photo-404">
    <img src="/images/404-hirshhorn.jpg" width="1120" height="840" alt="A gallery corridor curving out of view, lined with a layered, weathered artwork." />
  </figure>
</div>
</Layout>

<style>
  /* The photo sits behind the header on the right and fades out to the left, so the
     text stays on a clean background. On phones it becomes a band below the links. */
  .hero-404 {
    position: relative;
    overflow: hidden;
  }

  .hero-404 :global(.page-header) {
    position: relative;
    z-index: 1;
    min-height: 34rem;
    align-content: center;
  }

  .photo-404 {
    position: absolute;
    inset: 0 0 0 auto;
    width: 66%;
    margin: 0;
  }

  /* Fades out to the left, and softly at the top and bottom edges. Cropped from the
     left of the image so the far end of the corridor stays in view. */
  .photo-404 img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 20% 50%;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.35) 30%, #000 70%),
      linear-gradient(to bottom, transparent 0%, #000 14%, #000 86%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.35) 30%, #000 70%),
      linear-gradient(to bottom, transparent 0%, #000 14%, #000 86%, transparent 100%);
    mask-composite: intersect;
  }

  @media (max-width: 800px) {
    .hero-404 :global(.page-header) {
      min-height: 0;
    }

    .photo-404 {
      position: static;
      width: 100%;
    }

    .photo-404 img {
      height: 18rem;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 35%, #000 88%, transparent 100%);
      -webkit-mask-composite: source-over;
      mask-image: linear-gradient(to bottom, transparent 0%, #000 35%, #000 88%, transparent 100%);
      mask-composite: add;
    }
  }

  /* Keep the credit on the clean side of the faded photo. */
  .note {
    max-width: 26rem;
  }

  .destinations {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding-left: 1.25rem;
  }
</style>
